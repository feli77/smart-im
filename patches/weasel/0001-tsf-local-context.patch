diff --git a/include/SmartIMContextTrace.h b/include/SmartIMContextTrace.h
new file mode 100644
index 0000000..b8fee5f
--- /dev/null
+++ b/include/SmartIMContextTrace.h
@@ -0,0 +1,71 @@
+#pragma once
+
+#include <array>
+#include <cstdio>
+#include <string>
+#include <windows.h>
+
+namespace smart_im {
+
+// Opt-in diagnostics contain only fixed stage names, HRESULTs and counts.
+// Never pass document text, pinyin, candidate text or packet contents here.
+// Each thread keeps at most 48 records and overwrites its own bounded file.
+inline void TraceContext(const char* stage,
+                         HRESULT hr = S_OK,
+                         ULONG first = 0,
+                         ULONG second = 0) {
+  struct LastErrorGuard {
+    DWORD value = GetLastError();
+    ~LastErrorGuard() { SetLastError(value); }
+  } guard;
+  struct State {
+    ULONGLONG nextCheck = 0;
+    bool enabled = false;
+    std::wstring directory;
+    std::array<std::string, 48> records;
+    size_t count = 0;
+  };
+  static thread_local State state;
+  const ULONGLONG now = GetTickCount64();
+  if (now >= state.nextCheck) {
+    state.nextCheck = now + 1000;
+    WCHAR local[MAX_PATH]{};
+    const DWORD length =
+        GetEnvironmentVariableW(L"LOCALAPPDATA", local, MAX_PATH);
+    state.enabled = false;
+    if (length > 0 && length < MAX_PATH) {
+      state.directory = std::wstring(local) + L"\\SmartIM\\tsf-trace\\";
+      const DWORD attributes =
+          GetFileAttributesW((state.directory + L"enabled").c_str());
+      state.enabled = attributes != INVALID_FILE_ATTRIBUTES &&
+                      !(attributes & FILE_ATTRIBUTE_DIRECTORY);
+    }
+  }
+  if (!state.enabled)
+    return;
+  char line[192]{};
+  _snprintf_s(line, sizeof(line), _TRUNCATE, "%llu %s hr=%08lX a=%lu b=%lu\r\n",
+              now, stage, static_cast<ULONG>(hr), first, second);
+  state.records[state.count++ % state.records.size()] = line;
+  const size_t start = state.count > state.records.size()
+                           ? state.count - state.records.size()
+                           : 0;
+  std::string output;
+  for (size_t i = start; i < state.count; ++i)
+    output += state.records[i % state.records.size()];
+  const std::wstring path = state.directory +
+                            std::to_wstring(GetCurrentProcessId()) + L"-" +
+                            std::to_wstring(GetCurrentThreadId()) + L".log";
+  HANDLE file =
+      CreateFileW(path.c_str(), GENERIC_WRITE,
+                  FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                  nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (file != INVALID_HANDLE_VALUE) {
+    DWORD written = 0;
+    WriteFile(file, output.data(), static_cast<DWORD>(output.size()), &written,
+              nullptr);
+    CloseHandle(file);
+  }
+}
+
+}  // namespace smart_im

