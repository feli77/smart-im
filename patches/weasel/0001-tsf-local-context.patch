diff --git a/include/SmartIMContext.h b/include/SmartIMContext.h
new file mode 100644
index 0000000..5a01ada
--- /dev/null
+++ b/include/SmartIMContext.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <windows.h>
+#include <string>
+
+namespace smart_im {
+
+constexpr size_t kMaxPacket = 1700;
+constexpr size_t kMaxUnits = 128;
+
+inline int HexDigit(wchar_t c) {
+  if (c >= L'0' && c <= L'9') return c - L'0';
+  if (c >= L'a' && c <= L'f') return c - L'a' + 10;
+  if (c >= L'A' && c <= L'F') return c - L'A' + 10;
+  return -1;
+}
+
+inline bool ValidHexText(const std::wstring& hex) {
+  if (hex.size() > kMaxUnits * 6 || hex.size() % 2) return false;
+  if (hex.empty()) return true;
+  std::string bytes;
+  for (size_t i = 0; i < hex.size(); i += 2) {
+    const int high = HexDigit(hex[i]), low = HexDigit(hex[i + 1]);
+    if (high < 0 || low < 0) return false;
+    bytes.push_back(static_cast<char>((high << 4) | low));
+  }
+  const int units = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+                                       bytes.data(), static_cast<int>(bytes.size()),
+                                       nullptr, 0);
+  return units > 0 && units <= kMaxUnits;
+}
+
+// Empty is an explicit invalidation. All nonempty snapshots are one atomic
+// property, so Lua cannot combine a new token with old text (or vice versa).
+inline bool ValidPacket(const std::wstring& packet) {
+  if (packet.empty()) return true;
+  if (packet.size() > kMaxPacket || packet.compare(0, 2, L"1\t") != 0)
+    return false;
+  const auto token_end = packet.find(L'\t', 2);
+  if (token_end == std::wstring::npos || token_end < 3 || token_end > 66)
+    return false;
+  for (size_t i = 2; i < token_end; ++i) {
+    const wchar_t c = packet[i];
+    if (!((c >= L'a' && c <= L'z') || (c >= L'A' && c <= L'Z') ||
+          (c >= L'0' && c <= L'9') || c == L'_' || c == L'-')) return false;
+  }
+  const auto before_end = packet.find(L'\t', token_end + 1);
+  if (before_end == std::wstring::npos) return false;
+  return ValidHexText(packet.substr(token_end + 1, before_end - token_end - 1)) &&
+         ValidHexText(packet.substr(before_end + 1));
+}
+
+}  // namespace smart_im
