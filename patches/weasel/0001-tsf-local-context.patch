   HRESULT result = S_OK;
   STDMETHODIMP GetValue(TfEditCookie ec, ITfRange*, VARIANT* value) override {
     assert(ec == 42);
     VariantInit(value);
-    if (FAILED(result)) return result;
     value->vt = type;
-    if (type == VT_UNKNOWN) {
+    if (type == VT_UNKNOWN && !nullUnknown) {
       value->punkVal = &scope;
       scope.AddRef();
     }
@@ -195,11 +201,12 @@ class PropertyFixture : public ComFixture<ITfReadOnlyProperty> {
 class ContextFixture : public ComFixture<ITfContext> {
  public:
   HRESULT result = S_FALSE;
+  bool nullProperty = false;
   PropertyFixture property;
   STDMETHODIMP GetAppProperty(REFGUID guid, ITfReadOnlyProperty** out) override {
     assert(guid == GUID_PROP_INPUTSCOPE);
     *out = nullptr;
-    if (result == S_OK) { *out = &property; property.AddRef(); }
+    if (result == S_OK && !nullProperty) { *out = &property; property.AddRef(); }
     return result;
   }
   UNUSED_METHOD(RequestEditSession, (TfClientId, ITfEditSession*, DWORD, HRESULT*))
@@ -222,36 +229,68 @@ class ContextFixture : public ComFixture<ITfContext> {
 
 static void TestInputScopes() {
   ContextFixture context;
+  const auto expect = [&context](bool allowed, HRESULT expectedReason) {
+    HRESULT reason = E_UNEXPECTED;
+    assert(smart_im::AllowsContext(&context, 42, nullptr, &reason) == allowed);
+    assert(reason == expectedReason);
+    // The diagnostic output is optional for existing callers.
+    assert(smart_im::AllowsContext(&context, 42, nullptr) == allowed);
+  };
   // No property object is returned for these documented optional-property cases.
-  assert(smart_im::AllowsContext(&context, 42, nullptr));
+  expect(true, S_FALSE);
   context.result = E_NOTIMPL;
-  assert(smart_im::AllowsContext(&context, 42, nullptr));
+  expect(true, S_FALSE);
   for (HRESULT failure : {E_FAIL, E_INVALIDARG, TF_E_DISCONNECTED, E_OUTOFMEMORY}) {
     context.result = failure;
-    assert(!smart_im::AllowsContext(&context, 42, nullptr));
+    expect(false, failure);
   }
   context.result = S_OK;
-  assert(smart_im::AllowsContext(&context, 42, nullptr)); // VT_EMPTY
+  context.nullProperty = true;
+  expect(false, E_UNEXPECTED);
+  context.nullProperty = false;
+  expect(true, S_FALSE); // VT_EMPTY
   context.property.result = S_FALSE;
-  assert(smart_im::AllowsContext(&context, 42, nullptr)); // uncovered property
-  context.property.result = TF_E_NOLOCK;
-  assert(!smart_im::AllowsContext(&context, 42, nullptr));
+  expect(true, S_FALSE); // uncovered property
+  // Real Windows TSF returns this when an ACP store supplies no scope attribute.
+  context.property.result = E_FAIL;
+  expect(true, S_FALSE);
+  for (HRESULT failure : {TF_E_NOLOCK, TF_E_DISCONNECTED, E_ACCESSDENIED,
+                          E_INVALIDARG, E_OUTOFMEMORY, E_NOTIMPL}) {
+    context.property.result = failure;
+    expect(false, failure); // VT_EMPTY must not hide other failures
+  }
+  for (VARTYPE nonempty : {VT_I4, VT_UNKNOWN}) {
+    context.property.result = E_FAIL;
+    context.property.type = nonempty;
+    expect(false, E_FAIL); // failed nonempty variants are not missing scope
+  }
   context.property.result = S_OK;
   context.property.type = VT_I4;
-  assert(!smart_im::AllowsContext(&context, 42, nullptr));
+  expect(false, E_UNEXPECTED);
   context.property.type = VT_UNKNOWN;
-  assert(smart_im::AllowsContext(&context, 42, nullptr)); // IS_DEFAULT
+  context.property.nullUnknown = true;
+  expect(false, E_UNEXPECTED);
+  context.property.nullUnknown = false;
+  context.property.scope.queryResult = E_NOINTERFACE;
+  expect(false, E_NOINTERFACE);
+  context.property.scope.queryResult = S_OK;
+  expect(true, S_OK); // IS_DEFAULT
   context.property.scope.scope = IS_TEXT;
-  assert(smart_im::AllowsContext(&context, 42, nullptr));
+  expect(true, S_OK);
   for (InputScope privateScope : {IS_PASSWORD, IS_PRIVATE, IS_NUMERIC_PASSWORD,
                                  IS_NUMERIC_PIN, IS_ALPHANUMERIC_PIN,
                                  IS_ALPHANUMERIC_PIN_SET}) {
     context.property.scope.scope = privateScope;
-    assert(!smart_im::AllowsContext(&context, 42, nullptr));
+    expect(false, E_ACCESSDENIED);
   }
   context.property.scope.scope = IS_TEXT;
   context.property.scope.result = E_FAIL;
-  assert(!smart_im::AllowsContext(&context, 42, nullptr));
+  expect(false, E_FAIL);
+  context.property.scope.result = S_OK;
+  context.property.scope.missingArray = true;
+  expect(false, E_UNEXPECTED);
+  context.property.scope.scopeCount = 0;
+  expect(true, S_FALSE);
   assert(context.property.references == 1 && context.property.scope.references == 1);
 }
 
diff --git a/WeaselTSF/tests/RealTsfContextTest.cpp b/WeaselTSF/tests/RealTsfContextTest.cpp
new file mode 100644
index 0000000..eb87f58
--- /dev/null
+++ b/WeaselTSF/tests/RealTsfContextTest.cpp
@@ -0,0 +1,331 @@
+// Run in a VS developer prompt (no IME registration or installation required):
+// cl /std:c++17 /EHsc /utf-8 /DUNICODE /D_UNICODE RealTsfContextTest.cpp
+// /link ole32.lib oleaut32.lib uuid.lib
+// The Windows TSF manager reads only this test's synthesized in-memory store.
+#define NOMINMAX
+#include <windows.h>
+#include <ole2.h>
+#include <initguid.h>
+#include <msctf.h>
+#include <textstor.h>
+#include <inputscope.h>
+#include <atlcomcli.h>
+#include <algorithm>
+#include <cstdio>
+#include <cassert>
+#include <string>
+#include "../LocalContext.h"
+
+static void Require(HRESULT value) {
+  assert(SUCCEEDED(value));
+}
+
+template <class I>
+class ComBase : public I {
+ public:
+  STDMETHODIMP QueryInterface(REFIID iid, void** result) override {
+    *result = nullptr;
+    if (iid != IID_IUnknown && iid != __uuidof(I))
+      return E_NOINTERFACE;
+    *result = static_cast<I*>(this);
+    AddRef();
+    return S_OK;
+  }
+  STDMETHODIMP_(ULONG) AddRef() override { return ++refs; }
+  STDMETHODIMP_(ULONG) Release() override { return --refs; }
+  ULONG refs = 1;
+};
+#define STUB(name, args)            \
+  STDMETHODIMP name args override { \
+    return E_NOTIMPL;               \
+  }
+
+class Scopes : public ComBase<ITfInputScope> {
+ public:
+  InputScope value = IS_TEXT;
+  STDMETHODIMP GetInputScopes(InputScope** result, UINT* count) override {
+    *result = static_cast<InputScope*>(CoTaskMemAlloc(sizeof(InputScope)));
+    **result = value;
+    *count = 1;
+    return S_OK;
+  }
+  STUB(GetPhrase, (BSTR**, UINT*))
+  STUB(GetRegularExpression, (BSTR*))
+  STUB(GetSRGS, (BSTR*))
+  STUB(GetXML, (BSTR*))
+};
+
+class Store : public ComBase<ITextStoreACP> {
+ public:
+  Scopes scopes;
+  bool withScope = false;
+  CComPtr<ITextStoreACPSink> sink;
+  std::wstring text = L"existing left|existing right";
+  TS_SELECTION_ACP selection{14, 14, {TS_AE_NONE, FALSE}};
+  DWORD lock = 0;
+  STDMETHODIMP AdviseSink(REFIID iid, IUnknown* source, DWORD) override {
+    if (iid != IID_ITextStoreACPSink)
+      return E_NOINTERFACE;
+    sink.Release();
+    return source->QueryInterface(&sink);
+  }
+  STDMETHODIMP UnadviseSink(IUnknown*) override {
+    sink.Release();
+    return S_OK;
+  }
+  STDMETHODIMP RequestLock(DWORD flags, HRESULT* result) override {
+    if (!sink)
+      return E_FAIL;
+    if (lock) {
+      *result = TS_E_SYNCHRONOUS;
+      return S_OK;
+    }
+    lock = flags;
+    *result = sink->OnLockGranted(flags);
+    lock = 0;
+    return S_OK;
+  }
+  STDMETHODIMP GetStatus(TS_STATUS* status) override {
+    *status = {};
+    return S_OK;
+  }
+  STDMETHODIMP QueryInsert(LONG start,
+                           LONG end,
+                           ULONG,
+                           LONG* outStart,
+                           LONG* outEnd) override {
+    *outStart = start;
+    *outEnd = end;
+    return S_OK;
+  }
+  STDMETHODIMP GetSelection(ULONG,
+                            ULONG count,
+                            TS_SELECTION_ACP* out,
+                            ULONG* got) override {
+    if (!lock)
+      return TS_E_NOLOCK;
+    *got = count ? 1 : 0;
+    if (count)
+      *out = selection;
+    return S_OK;
+  }
+  STDMETHODIMP SetSelection(ULONG count,
+                            const TS_SELECTION_ACP* value) override {
+    if (!(lock & TS_LF_READWRITE))
+      return TS_E_NOLOCK;
+    if (count != 1)
+      return E_INVALIDARG;
+    selection = *value;
+    return S_OK;
+  }
+  STDMETHODIMP GetText(LONG start,
+                       LONG end,
+                       WCHAR* buffer,
+                       ULONG capacity,
+                       ULONG* written,
+                       TS_RUNINFO* runs,
+                       ULONG runCapacity,
+                       ULONG* runCount,
+                       LONG* next) override {
+    if (!lock)
+      return TS_E_NOLOCK;
+    if (end == -1)
+      end = static_cast<LONG>(text.size());
+    if (start < 0 || end < start || end > static_cast<LONG>(text.size()))
+      return TS_E_INVALIDPOS;
+    ULONG count = static_cast<ULONG>(end - start);
+    if (buffer)
+      count = (std::min)(capacity, count);
+    if (written)
+      *written = buffer ? count : 0;
+    if (buffer)
+      std::copy_n(text.data() + start, count, buffer);
+    if (runCount)
+      *runCount = runCapacity && count ? 1 : 0;
+    if (runCapacity && count)
+      *runs = {count, TS_RT_PLAIN};
+    if (next)
+      *next = start + count;
+    return S_OK;
+  }
+  STDMETHODIMP SetText(DWORD,
+                       LONG start,
+                       LONG end,
+                       const WCHAR* value,
+                       ULONG count,
+                       TS_TEXTCHANGE* change) override {
+    text.replace(start, end - start, value, count);
+    *change = {start, end, start + static_cast<LONG>(count)};
+    return S_OK;
+  }
+  STUB(GetFormattedText, (LONG, LONG, IDataObject**))
+  STUB(GetEmbedded, (LONG, REFGUID, REFIID, IUnknown**))
+  STDMETHODIMP QueryInsertEmbedded(const GUID*,
+                                   const FORMATETC*,
+                                   BOOL* allowed) override {
+    *allowed = FALSE;
+    return S_OK;
+  }
+  STUB(InsertEmbedded, (DWORD, LONG, LONG, IDataObject*, TS_TEXTCHANGE*))
+  STDMETHODIMP InsertTextAtSelection(DWORD flags,
+                                     const WCHAR* value,
+                                     ULONG count,
+                                     LONG* start,
+                                     LONG* end,
+                                     TS_TEXTCHANGE* change) override {
+    if (start)
+      *start = selection.acpStart;
+    if (end)
+      *end = selection.acpEnd;
+    if (flags & TS_IAS_QUERYONLY)
+      return S_OK;
+    return SetText(0, selection.acpStart, selection.acpEnd, value, count,
+                   change);
+  }
+  STUB(InsertEmbeddedAtSelection,
+       (DWORD, IDataObject*, LONG*, LONG*, TS_TEXTCHANGE*))
+  STDMETHODIMP RequestSupportedAttrs(DWORD, ULONG, const TS_ATTRID*) override {
+    return S_OK;
+  }
+  STDMETHODIMP RequestAttrsAtPosition(LONG,
+                                      ULONG,
+                                      const TS_ATTRID*,
+                                      DWORD) override {
+    return S_OK;
+  }
+  STDMETHODIMP RequestAttrsTransitioningAtPosition(LONG,
+                                                   ULONG,
+                                                   const TS_ATTRID*,
+                                                   DWORD) override {
+    return S_OK;
+  }
+  STDMETHODIMP FindNextAttrTransition(LONG,
+                                      LONG halt,
+                                      ULONG,
+                                      const TS_ATTRID*,
+                                      DWORD,
+                                      LONG* next,
+                                      BOOL* found,
+                                      LONG* offset) override {
+    *next = halt;
+    *found = FALSE;
+    *offset = 0;
+    return S_OK;
+  }
+  STDMETHODIMP RetrieveRequestedAttrs(ULONG capacity,
+                                      TS_ATTRVAL* attrs,
+                                      ULONG* count) override {
+    *count = 0;
+    if (withScope && capacity) {
+      attrs[0].idAttr = GUID_PROP_INPUTSCOPE;
+      attrs[0].dwOverlapId = 0;
+      VariantInit(&attrs[0].varValue);
+      attrs[0].varValue.vt = VT_UNKNOWN;
+      attrs[0].varValue.punkVal = &scopes;
+      scopes.AddRef();
+      *count = 1;
+    }
+    return S_OK;
+  }
+  STDMETHODIMP GetEndACP(LONG* end) override {
+    *end = static_cast<LONG>(text.size());
+    return S_OK;
+  }
+  STDMETHODIMP GetActiveView(TsViewCookie* view) override {
+    *view = 1;
+    return S_OK;
+  }
+  STUB(GetACPFromPoint, (TsViewCookie, const POINT*, DWORD, LONG*))
+  STDMETHODIMP GetTextExt(TsViewCookie,
+                          LONG,
+                          LONG,
+                          RECT* rect,
+                          BOOL* clipped) override {
+    *rect = {0, 0, 100, 20};
+    *clipped = FALSE;
+    return S_OK;
+  }
+  STDMETHODIMP GetScreenExt(TsViewCookie, RECT* rect) override {
+    *rect = {0, 0, 100, 20};
+    return S_OK;
+  }
+  STDMETHODIMP GetWnd(TsViewCookie, HWND* window) override {
+    *window = nullptr;
+    return S_OK;
+  }
+};
+
+class Probe : public ComBase<ITfEditSession> {
+ public:
+  CComPtr<ITfContext> context;
+  bool expectedAllowed = true;
+  HRESULT expectedReason = S_OK;
+  bool called = false;
+  STDMETHODIMP DoEditSession(TfEditCookie ec) override {
+    called = true;
+    TF_SELECTION selection{};
+    ULONG fetched = 0;
+    Require(context->GetSelection(ec, TF_DEFAULT_SELECTION, 1, &selection,
+                                  &fetched));
+    assert(fetched == 1 && selection.range);
+    CComPtr<ITfRange> range;
+    range.Attach(selection.range);
+    HRESULT reason = E_UNEXPECTED;
+    assert(smart_im::AllowsContext(context, ec, range, &reason) ==
+           expectedAllowed);
+    assert(reason == expectedReason);
+    if (expectedAllowed) {
+      std::wstring before, after;
+      assert(smart_im::ReadSide(ec, range, true, before));
+      assert(smart_im::ReadSide(ec, range, false, after));
+      assert(before == L"existing left|" && after == L"existing right");
+    }
+    return S_OK;
+  }
+};
+
+static void Check(bool withScope,
+                  InputScope scope,
+                  bool allowed,
+                  HRESULT reason) {
+  Store store;
+  store.withScope = withScope;
+  store.scopes.value = scope;
+  Probe probe;
+  probe.expectedAllowed = allowed;
+  probe.expectedReason = reason;
+  CComPtr<ITfThreadMgrEx> manager;
+  Require(manager.CoCreateInstance(CLSID_TF_ThreadMgr));
+  TfClientId client = TF_CLIENTID_NULL;
+  Require(manager->ActivateEx(
+      &client, TF_TMAE_NOACTIVATETIP | TF_TMAE_NOACTIVATEKEYBOARDLAYOUT));
+  CComPtr<ITfDocumentMgr> document;
+  Require(manager->CreateDocumentMgr(&document));
+  TfEditCookie ownerCookie = 0;
+  Require(
+      document->CreateContext(client, 0, &store, &probe.context, &ownerCookie));
+  Require(document->Push(probe.context));
+  HRESULT result = E_UNEXPECTED;
+  Require(probe.context->RequestEditSession(client, &probe,
+                                            TF_ES_SYNC | TF_ES_READ, &result));
+  Require(result);
+  assert(probe.called);
+  Require(document->Pop(TF_POPF_ALL));
+  probe.context.Release();
+  document.Release();
+  Require(manager->Deactivate());
+}
+
+int main() {
+  Require(CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED));
+  Check(false, IS_DEFAULT, true, S_FALSE);
+  Check(true, IS_DEFAULT, true, S_OK);
+  Check(true, IS_TEXT, true, S_OK);
+  for (InputScope sensitive :
+       {IS_PASSWORD, IS_PRIVATE, IS_NUMERIC_PASSWORD, IS_NUMERIC_PIN,
+        IS_ALPHANUMERIC_PIN, IS_ALPHANUMERIC_PIN_SET}) {
+    Check(true, sensitive, false, E_ACCESSDENIED);
+  }
+  CoUninitialize();
+  std::puts("Real Windows TSF optional-scope and bounded-read tests passed");
+}

