diff --git a/test/SmartIMContextTest.cpp b/test/SmartIMContextTest.cpp
new file mode 100644
index 0000000..7772069
--- /dev/null
+++ b/test/SmartIMContextTest.cpp
@@ -0,0 +1,96 @@
+#include <SmartIMContext.h>
+
+#include <cstdlib>
+#include <iostream>
+#include <string>
+
+namespace {
+
+int checks = 0;
+
+void Check(bool condition, const char* name) {
+  ++checks;
+  if (!condition) {
+    std::cerr << "FAIL: " << name << '\n';
+    std::exit(EXIT_FAILURE);
+  }
+}
+
+std::wstring Repeat(const std::wstring& value, size_t count) {
+  std::wstring result;
+  for (size_t i = 0; i < count; ++i)
+    result += value;
+  return result;
+}
+
+std::wstring Packet(const std::wstring& token,
+                    const std::wstring& before = L"",
+                    const std::wstring& after = L"") {
+  return L"1\t" + token + L"\t" + before + L"\t" + after;
+}
+
+}  // namespace
+
+int main() {
+  using smart_im::ValidHexText;
+  using smart_im::ValidPacket;
+
+  Check(ValidPacket(L""), "empty packet explicitly invalidates the snapshot");
+  Check(ValidPacket(Packet(L"t")), "empty document on both sides");
+  Check(ValidPacket(Packet(L"doc-7_caret-22", L"e5898d", L"e5908e")),
+        "independent Chinese before and after context");
+  Check(ValidPacket(Packet(L"Mixed_CASE-123", L"E5898D", L"F09F9880")),
+        "uppercase hex, token alphabet, and supplementary Unicode");
+  Check(ValidPacket(Packet(L"t", L"e5898d0a09", L"0d0a20")),
+        "encoded tabs and newlines stay inside their text fields");
+  Check(ValidPacket(Packet(std::wstring(64, L'x'))), "maximum token length");
+  Check(ValidPacket(Packet(L"t", L"", L"e5908e")), "after-only context");
+  Check(ValidPacket(Packet(L"t", L"e5898d", L"")), "before-only context");
+
+  const auto full_bmp = Repeat(L"e4b880", 128);
+  const auto full_pairs = Repeat(L"f09f9880", 64);
+  Check(ValidPacket(Packet(std::wstring(64, L't'), full_bmp, full_bmp)),
+        "maximum UTF-16 fields and token fit in one bounded packet");
+  Check(ValidPacket(Packet(L"t", full_pairs, full_pairs)),
+        "surrogate pairs count as two UTF-16 units");
+  Check(ValidHexText(std::wstring()), "empty encoded text");
+  Check(ValidHexText(Repeat(L"61", 128)), "128 ASCII UTF-16 units");
+  Check(ValidHexText(Repeat(L"c2a2", 128)), "128 two-byte UTF-8 units");
+  Check(ValidHexText(full_bmp), "128 three-byte UTF-8 units");
+  Check(ValidHexText(full_pairs), "128 UTF-16 units in supplementary characters");
+  Check(!ValidHexText(Repeat(L"61", 129)), "ASCII context over UTF-16 bound");
+  Check(!ValidHexText(Repeat(L"c2a2", 129)), "two-byte context over UTF-16 bound");
+  Check(!ValidHexText(full_bmp + L"61"), "context over encoded-byte bound");
+  Check(!ValidHexText(full_pairs + L"61"), "supplementary context over UTF-16 bound");
+  Check(!ValidPacket(Packet(L"t", full_bmp + L"61", L"")),
+        "before context bound is enforced independently");
+  Check(!ValidPacket(Packet(L"t", L"", full_bmp + L"61")),
+        "after context bound is enforced independently");
+
+  for (const auto* invalid : {L"0", L"gg", L"61 62", L"ff", L"80", L"c0af",
+                              L"eda080", L"f4908080", L"f09f98", L"efbf"}) {
+    Check(!ValidHexText(invalid), "malformed UTF-8 or hex rejected");
+    Check(!ValidPacket(Packet(L"t", invalid, L"")),
+          "malformed before field rejected");
+    Check(!ValidPacket(Packet(L"t", L"", invalid)),
+          "malformed after field rejected");
+  }
+
+  for (const auto& token : {L"", L"../field", L"field space", L"field\nnext",
+                           L"field\tother", L"field.dot", L"\x4e2d"}) {
+    Check(!ValidPacket(Packet(token)), "unsafe or empty token rejected");
+  }
+  Check(!ValidPacket(Packet(std::wstring(65, L'x'))), "oversized token rejected");
+  Check(!ValidPacket(L"0\tt\t\t"), "unsupported protocol version rejected");
+  Check(!ValidPacket(L"2\tt\t\t"), "future protocol version rejected");
+  Check(!ValidPacket(L"1\tt\t"), "missing after field rejected");
+  Check(!ValidPacket(L"1\tt\t\t\t"), "extra field rejected");
+  Check(!ValidPacket(L"1\tt\t61\t62\n"), "raw newline rejected");
+  Check(!ValidPacket(Packet(L"t") + std::wstring(1, L'\0')),
+        "embedded raw NUL rejected");
+  Check(!ValidPacket(Packet(L"t") + std::wstring(smart_im::kMaxPacket, L'0')),
+        "oversized packet rejected before parsing");
+
+  std::cout << "SmartIMContextTest: " << checks << " checks passed\n";
+  return EXIT_SUCCESS;
+}
diff --git a/test/SmartIMPipeTest.cpp b/test/SmartIMPipeTest.cpp
new file mode 100644
index 0000000..ce4157f
--- /dev/null
+++ b/test/SmartIMPipeTest.cpp
@@ -0,0 +1,234 @@
+#include <PipeChannel.h>
+#include <SmartIMContext.h>
+
+#include <cstring>
+#include <functional>
+#include <future>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+int checks = 0;
+
+void Check(bool condition, const char* name) {
+  ++checks;
+  if (!condition)
+    throw std::runtime_error(name);
+}
+
+struct Header {
+  DWORD command;
+  DWORD length;
+  DWORD session;
+};
+
+class Receiver : public weasel::PipeChannel<DWORD, Header> {
+ public:
+  explicit Receiver(std::wstring name = L"unused") : PipeChannel(std::move(name)) {}
+
+  HANDLE Accept() { return _ConnectServerPipe(pname); }
+
+  Header Receive(HANDLE pipe) {
+    Header header{};
+    _Receive(pipe, &header, sizeof(header));
+    return header;
+  }
+
+  void Respond(HANDLE pipe, DWORD result) { _Send(pipe, result); }
+};
+
+struct PipePair {
+  HANDLE server = INVALID_HANDLE_VALUE;
+  HANDLE client = INVALID_HANDLE_VALUE;
+  std::wstring name;
+
+  explicit PipePair(int serial, bool raw_client = true) {
+    name = L"\\\\.\\pipe\\smart-im-context-test-" +
+        std::to_wstring(GetCurrentProcessId()) + L"-" + std::to_wstring(serial);
+    server = CreateNamedPipeW(name.c_str(), PIPE_ACCESS_DUPLEX,
+        PIPE_TYPE_MESSAGE | PIPE_READMODE_MESSAGE | PIPE_WAIT, 1, 65536, 65536,
+        1000, nullptr);
+    Check(server != INVALID_HANDLE_VALUE, "create named pipe");
+    if (!raw_client) return;
+    client = CreateFileW(name.c_str(), GENERIC_READ | GENERIC_WRITE, 0, nullptr,
+        OPEN_EXISTING, 0, nullptr);
+    Check(client != INVALID_HANDLE_VALUE, "connect named-pipe client");
+    Check(ConnectNamedPipe(server, nullptr) || GetLastError() == ERROR_PIPE_CONNECTED,
+          "accept named-pipe client");
+    DWORD mode = PIPE_READMODE_MESSAGE;
+    Check(SetNamedPipeHandleState(client, &mode, nullptr, nullptr) != FALSE,
+          "client reads complete messages");
+  }
+
+  ~PipePair() {
+    if (client != INVALID_HANDLE_VALUE) CloseHandle(client);
+    if (server != INVALID_HANDLE_VALUE) CloseHandle(server);
+  }
+
+  void Send(Header header, const std::wstring* body = nullptr) {
+    const size_t body_bytes = body ? (body->size() + 1) * sizeof(wchar_t) : 0;
+    std::vector<char> message(sizeof(header) + body_bytes);
+    std::memcpy(message.data(), &header, sizeof(header));
+    if (body)
+      std::memcpy(message.data() + sizeof(header), body->c_str(), body_bytes);
+    DWORD written = 0;
+    Check(WriteFile(client, message.data(), static_cast<DWORD>(message.size()),
+                    &written, nullptr) && written == message.size(),
+          "send framed request");
+  }
+};
+
+std::wstring Body(const Receiver& receiver, const Header& header) {
+  Check(receiver.ReceivedBodySize() == (header.length + 1) * sizeof(wchar_t),
+        "received body byte count excludes header");
+  const auto* body = reinterpret_cast<const wchar_t*>(receiver.ReceivedBody());
+  Check(body[header.length] == L'\0', "received body includes terminator");
+  return std::wstring(body, header.length);
+}
+
+}  // namespace
+
+int main() {
+  try {
+    PipePair first(1), second(2);
+    Receiver first_receiver, second_receiver;
+    const std::wstring first_packet = L"1\tfirst-field\te5898d\te5908e";
+    const std::wstring second_packet = L"1\tsecond-field\t616263\t646566";
+
+    // Both reads are active before dispatch. The second connection must not
+    // overwrite the first connection's pending body (the old shared buffer did).
+    auto first_read = std::async(std::launch::async, [&] {
+      return first_receiver.Receive(first.server);
+    });
+    auto second_read = std::async(std::launch::async, [&] {
+      return second_receiver.Receive(second.server);
+    });
+    first.Send({1, static_cast<DWORD>(first_packet.size()), 101}, &first_packet);
+    second.Send({1, static_cast<DWORD>(second_packet.size()), 202}, &second_packet);
+    const auto first_header = first_read.get(), second_header = second_read.get();
+    Check(first_header.session == 101 && second_header.session == 202,
+          "parallel clients preserve their session headers");
+    Check(Body(first_receiver, first_header) == first_packet,
+          "first packet keeps its leading framing and token after second receive");
+    Check(Body(second_receiver, second_header) == second_packet,
+          "second packet keeps its independent context");
+    Check(smart_im::ValidPacket(Body(first_receiver, first_header)),
+          "real pipe transport delivers a valid complete context packet");
+
+    // Header-only requests must not be able to reuse the previous body.
+    first.Send({1, first_header.length, 101});
+    first_receiver.Receive(first.server);
+    Check(first_receiver.ReceivedBodySize() == 0,
+          "missing body is observable even after a valid preceding request");
+
+    const std::wstring short_body = L"1\tx\t\t";
+    first.Send({1, 1700, 101}, &short_body);
+    const auto truncated = first_receiver.Receive(first.server);
+    Check(first_receiver.ReceivedBodySize() < (truncated.length + 1) * sizeof(wchar_t),
+          "truncated packet cannot masquerade as the declared full body");
+
+    // A malformed header is rejected before any handler sees it.
+    DWORD fragment = 1, written = 0;
+    Check(WriteFile(first.client, &fragment, sizeof(fragment), &written, nullptr) != FALSE,
+          "send truncated header");
+    bool rejected = false;
+    try {
+      first_receiver.Receive(first.server);
+    } catch (DWORD error) {
+      rejected = error == ERROR_INVALID_DATA;
+    }
+    Check(rejected, "truncated header is rejected with a transport error");
+    Check(first_receiver.ReceivedBodySize() == 0, "failed receive leaves no stale body size");
+
+    // Sending a response also has to use the request's own buffer. Run its
+    // writer concurrently because production _Send flushes until the client reads.
+    second_receiver << L"context=second\n" << L'\0';
+    auto response = std::async(std::launch::async, [&] {
+      second_receiver.Respond(second.server, 7);
+    });
+    std::vector<char> reply(65536);
+    DWORD read = 0;
+    Check(ReadFile(second.client, reply.data(), static_cast<DWORD>(reply.size()),
+                   &read, nullptr) != FALSE, "read response from matching connection");
+    response.get();
+    Check(read >= sizeof(DWORD) + 2 && *reinterpret_cast<const DWORD*>(reply.data()) == 7,
+          "response header belongs to matching request");
+    Check(std::wstring(reinterpret_cast<const wchar_t*>(reply.data() + sizeof(DWORD))) ==
+              L"context=second\n",
+          "response body uses the matching connection buffer");
+
+    // A TSF edit callback can publish context after key handling returns but
+    // before GetResponseData consumes its response. The notification must use
+    // an independent client channel so its outgoing body cannot replace that
+    // pending key response.
+    PipePair key_pipe(3, false), context_pipe(4, false);
+    weasel::PipeChannel<Header> key_client(std::wstring(key_pipe.name));
+    weasel::PipeChannel<Header> context_client(std::wstring(context_pipe.name));
+    Check(key_client.Connect() && context_client.Connect(),
+          "independent key and context clients connect");
+    Check(ConnectNamedPipe(key_pipe.server, nullptr) || GetLastError() == ERROR_PIPE_CONNECTED,
+          "accept key client");
+    Check(ConnectNamedPipe(context_pipe.server, nullptr) || GetLastError() == ERROR_PIPE_CONNECTED,
+          "accept context client");
+    Receiver key_server, context_server;
+    auto key_worker = std::async(std::launch::async, [&] {
+      const auto header = key_server.Receive(key_pipe.server);
+      key_server << L"action=ctx\nctx.preedit=original-key-response\n.\n" << L'\0';
+      key_server.Respond(key_pipe.server, 1);
+      return header;
+    });
+    Header key_request{2, 0, 303};
+    Check(key_client.Transact(key_request) == 1, "key operation returns before response consumed");
+    Check(key_worker.get().session == 303, "key request session arrives");
+    auto context_worker = std::async(std::launch::async, [&] {
+      const auto header = context_server.Receive(context_pipe.server);
+      const auto* body = reinterpret_cast<const wchar_t*>(context_server.ReceivedBody());
+      const std::wstring packet(body, header.length);
+      context_server.Respond(context_pipe.server, 1);
+      return packet;
+    });
+    context_client << second_packet.c_str() << L'\0';
+    Header context_request{1, static_cast<DWORD>(second_packet.size()), 303};
+    Check(context_client.Transact(context_request) == 1,
+          "context notification completes between key operation and response read");
+    Check(context_worker.get() == second_packet, "context notification arrives intact");
+    std::wstring pending_key_response;
+    std::function<bool(wchar_t*, UINT)> consume_response = [&](wchar_t* body, UINT) {
+      pending_key_response = body;
+      return true;
+    };
+    Check(key_client.HandleResponseData(consume_response), "read pending key response");
+    Check(pending_key_response == L"action=ctx\nctx.preedit=original-key-response\n.\n",
+          "interleaved context transact preserves unconsumed key response");
+
+    // Exercise the production accept path with a racing first client. This
+    // accepts both a pending ConnectNamedPipe and ERROR_PIPE_CONNECTED.
+    const auto accept_name = L"\\\\.\\pipe\\smart-im-context-accept-" +
+        std::to_wstring(GetCurrentProcessId());
+    Receiver accepting(accept_name);
+    auto accept_worker = std::async(std::launch::async, [&] { return accepting.Accept(); });
+    bool ready = false;
+    for (int attempt = 0; attempt < 1000 && !ready; ++attempt) {
+      ready = WaitNamedPipeW(accept_name.c_str(), 10) != FALSE;
+      if (!ready) Sleep(1);
+    }
+    Check(ready, "production server creates a connectable pipe");
+    weasel::PipeChannel<Header> accepted_client{std::wstring(accept_name)};
+    Check(accepted_client.Connect(), "first client connects to production accept path");
+    HANDLE accepted_pipe = accept_worker.get();
+    Check(accepted_pipe != INVALID_HANDLE_VALUE, "production accept returns connected handle");
+    accepted_client.Disconnect();
+    CloseHandle(accepted_pipe);
+
+    std::cout << "SmartIMPipeTest: " << checks << " checks passed\n";
+    return 0;
+  } catch (const std::exception& error) {
+    std::cerr << "FAIL: " << error.what() << '\n';
+  } catch (DWORD error) {
+    std::cerr << "FAIL: Windows pipe error " << error << '\n';
+  }
+  return 1;
+}

From 05f44708bb49390626064bbd346b448c4f2906d1 Mon Sep 17 00:00:00 2001
