diff --git a/WeaselTSF/LocalContext.cpp b/WeaselTSF/LocalContext.cpp
new file mode 100644
index 0000000..c63dcbb
--- /dev/null
+++ b/WeaselTSF/LocalContext.cpp
@@ -0,0 +1,177 @@
+#include "stdafx.h"
+#include "EditSession.h"
+#include "LocalContext.h"
+#include <SmartIMContext.h>
+#include <inputscope.h>
+
+namespace {
+
+// Input scope is optional (VT_EMPTY). Malformed/failed scope reads cannot
+// authorize collecting text. Disabled/secure contexts are rejected earlier.
+bool AllowsContext(ITfContext* context, TfEditCookie ec, ITfRange* selection) {
+  CComPtr<ITfReadOnlyProperty> property;
+  if (FAILED(context->GetAppProperty(GUID_PROP_INPUTSCOPE, &property)) || !property)
+    return false;
+  CComVariant value;
+  if (FAILED(property->GetValue(ec, selection, &value)))
+    return false;
+  if (value.vt == VT_EMPTY)
+    return true;
+  if (value.vt != VT_UNKNOWN || !value.punkVal)
+    return false;
+  CComPtr<ITfInputScope> scope;
+  if (FAILED(value.punkVal->QueryInterface(IID_PPV_ARGS(&scope))))
+    return false;
+  InputScope* scopes = nullptr;
+  UINT count = 0;
+  if (FAILED(scope->GetInputScopes(&scopes, &count))) {
+    CoTaskMemFree(scopes);
+    return false;
+  }
+  bool allowed = count == 0 || scopes != nullptr;
+  for (UINT i = 0; allowed && i < count; ++i) {
+    switch (scopes[i]) {
+      case IS_PASSWORD:
+      case IS_PRIVATE:
+      case IS_NUMERIC_PASSWORD:
+      case IS_NUMERIC_PIN:
+      case IS_ALPHANUMERIC_PIN:
+      case IS_ALPHANUMERIC_PIN_SET:
+        allowed = false;
+        break;
+      default:
+        break;
+    }
+  }
+  CoTaskMemFree(scopes);
+  return allowed;
+}
+
+class CReadLocalContextSession : public CEditSession {
+ public:
+  CReadLocalContextSession(WeaselTSF* service, ITfContext* context)
+      : CEditSession(service, context) {}
+
+  STDMETHODIMP DoEditSession(TfEditCookie ec) override {
+    return _pTextService->_ReadLocalContext(_pContext, ec) ? S_OK : E_FAIL;
+  }
+};
+
+}  // namespace
+
+void WeaselTSF::_InvalidateLocalContext(bool documentChanged) {
+  if (documentChanged)
+    ++_documentEpoch;
+  ++_localContextGeneration;
+  _localContext.Release();
+  _localSelection.Release();
+  _localBefore.clear();
+  _localAfter.clear();
+  if (!_localContextPacket.empty()) {
+    _localContextPacket.clear();
+    _localPublishedPacket.clear();
+    m_client.UpdateLocalContext(L"");
+    _HideUI();
+  }
+}
+
+bool WeaselTSF::_ReadLocalContext(ITfContext* context,
+                                  TfEditCookie ec,
+                                  bool compareSelection) {
+  if (!context || !_pThreadMgr || _localContextSuspended ||
+      _pendingCompositionEnds.count(context) != 0 ||
+      _status.schema_id != L"smart_im" || _status.disabled ||
+      (_activateFlags & TF_TMF_SECUREMODE) || _IsKeyboardDisabled())
+    return false;
+  CComPtr<ITfDocumentMgr> focused;
+  CComPtr<ITfContext> top;
+  TF_STATUS status{};
+  if (_pThreadMgr->GetFocus(&focused) != S_OK || !focused ||
+      focused->GetTop(&top) != S_OK || top.p != context ||
+      context->GetStatus(&status) != S_OK ||
+      (status.dwStaticFlags & TS_SS_TRANSITORY))
+    return false;
+
+  TF_SELECTION selection{};
+  ULONG fetched = 0;
+  if (context->GetSelection(ec, TF_DEFAULT_SELECTION, 1, &selection, &fetched) != S_OK ||
+      fetched != 1 || !selection.range)
+    return false;
+  CComPtr<ITfRange> selectionRange;
+  selectionRange.Attach(selection.range);
+  if (!AllowsContext(context, ec, selectionRange))
+    return false;
+
+  CComPtr<ITfRange> replacement = selectionRange;
+  if (_pComposition) {
+    CComPtr<ITfRange> composition;
+    CComPtr<ITfContext> owner;
+    if (_pComposition->GetRange(&composition) != S_OK || !composition ||
+        composition->GetContext(&owner) != S_OK || owner.p != context ||
+        !smart_im::Covers(ec, composition, selectionRange))
+      return false;
+    replacement = composition;
+  }
+  std::wstring before, after, beforeHex, afterHex;
+  if (!smart_im::ReadSide(ec, replacement, true, before) ||
+      !smart_im::ReadSide(ec, replacement, false, after) ||
+      !smart_im::Utf8Hex(before, beforeHex) ||
+      !smart_im::Utf8Hex(after, afterHex))
+    return false;
+
+  const bool moved = compareSelection && _localSelection &&
+      !smart_im::SameRange(ec, _localSelection, selectionRange);
+  if (_localContext.p != context || moved || _localBefore != before || _localAfter != after)
+    _InvalidateLocalContext(moved || (_localContext && _localContext.p != context));
+  _localContext = context;
+  _localSelection.Release();
+  if (selectionRange->Clone(&_localSelection) != S_OK)
+    return false;
+  _localBefore = before;
+  _localAfter = after;
+  const std::wstring token = std::to_wstring(GetCurrentProcessId()) + L"_" +
+      std::to_wstring(GetCurrentThreadId()) + L"_" +
+      std::to_wstring(reinterpret_cast<ULONG_PTR>(this)) + L"_" +
+      std::to_wstring(_localContextGeneration);
+  _localContextPacket = L"1\t" + token + L"\t" + beforeHex + L"\t" + afterHex;
+  return smart_im::ValidPacket(_localContextPacket);
+}
+
+void WeaselTSF::_PublishLocalContext(bool force) {
+  if (!_localContextPacket.empty() &&
+      (force || _localContextPacket != _localPublishedPacket)) {
+    if (m_client.UpdateLocalContext(_localContextPacket))
+      _localPublishedPacket = _localContextPacket;
+    else
+      _InvalidateLocalContext();
+  }
+}
+
+void WeaselTSF::_RefreshLocalContext(ITfContext* context) {
+  // Called in keystroke handling before Rime processes that key. A denied
+  // synchronous read fails closed; an asynchronous snapshot would be too late.
+  if (!context) {
+    _InvalidateLocalContext();
+    return;
+  }
+  CComPtr<CReadLocalContextSession> session;
+  session.Attach(new CReadLocalContextSession(this, context));
+  HRESULT result = E_FAIL;
+  const HRESULT hr = context->RequestEditSession(_tfClientId, session,
+                                                TF_ES_SYNC | TF_ES_READ, &result);
+  if (FAILED(hr) || result != S_OK)
+    _InvalidateLocalContext();
+  else
+    // A server reconnect or schema switch may have replaced the Rime context.
+    // The server deduplicates equal properties without notifying Lua again.
+    _PublishLocalContext(true);
+}
+
+bool WeaselTSF::_IsCurrentDocument(ITfContext* context, ULONGLONG epoch) const {
+  if (!_pThreadMgr || _localContextSuspended || epoch != _documentEpoch)
+    return false;
+  CComPtr<ITfDocumentMgr> document;
+  CComPtr<ITfContext> top;
+  return _pThreadMgr->GetFocus(&document) == S_OK && document &&
+      document->GetTop(&top) == S_OK && top.p == context;
+}
diff --git a/WeaselTSF/LocalContext.h b/WeaselTSF/LocalContext.h
new file mode 100644
index 0000000..6701900
--- /dev/null
+++ b/WeaselTSF/LocalContext.h
@@ -0,0 +1,80 @@
+#pragma once
+
+#include <string>
+#include <windows.h>
+#include <msctf.h>
+#include <atlcomcli.h>
+
+namespace smart_im {
+
+// Limits are UTF-16 code units at the TSF boundary. Neither side reads the
+// complete document, crosses a region, or includes the replacement range.
+constexpr ULONG kContextUnits = 128;
+
+inline bool Covers(TfEditCookie ec, ITfRange* cover, ITfRange* selection) {
+  LONG start = 0, end = 0;
+  return cover->CompareStart(ec, selection, TF_ANCHOR_START, &start) == S_OK &&
+         cover->CompareEnd(ec, selection, TF_ANCHOR_END, &end) == S_OK &&
+         start <= 0 && end >= 0;
+}
+
+inline bool SameRange(TfEditCookie ec, ITfRange* left, ITfRange* right) {
+  LONG start = 0, end = 0;
+  return left && right &&
+         left->CompareStart(ec, right, TF_ANCHOR_START, &start) == S_OK &&
+         left->CompareEnd(ec, right, TF_ANCHOR_END, &end) == S_OK &&
+         start == 0 && end == 0;
+}
+
+inline bool ReadSide(TfEditCookie ec,
+                     ITfRange* replacement,
+                     bool before,
+                     std::wstring& text) {
+  CComPtr<ITfRange> range;
+  if (replacement->Clone(&range) != S_OK || !range ||
+      range->Collapse(ec, before ? TF_ANCHOR_START : TF_ANCHOR_END) != S_OK)
+    return false;
+  LONG moved = 0;
+  const HRESULT hr = before
+      ? range->ShiftStart(ec, -static_cast<LONG>(kContextUnits), &moved, nullptr)
+      : range->ShiftEnd(ec, static_cast<LONG>(kContextUnits), &moved, nullptr);
+  if (FAILED(hr))
+    return false;
+  const LONG expected = before ? -moved : moved;
+  if (expected < 0 || expected > static_cast<LONG>(kContextUnits))
+    return false;
+  WCHAR buffer[kContextUnits];
+  ULONG count = 0;
+  // Do not use TF_TF_IGNOREEND: it would include composition/selected text.
+  if (range->GetText(ec, 0, buffer, kContextUnits, &count) != S_OK ||
+      count != static_cast<ULONG>(expected))
+    return false;
+  text.assign(buffer, count);
+  // A bounded read may cut a surrogate pair at its outer edge.
+  if (before && !text.empty() && text.front() >= 0xdc00 && text.front() <= 0xdfff)
+    text.erase(0, 1);
+  if (!before && !text.empty() && text.back() >= 0xd800 && text.back() <= 0xdbff)
+    text.pop_back();
+  return text.find(L'\0') == std::wstring::npos;
+}
+
+inline bool Utf8Hex(const std::wstring& text, std::wstring& result) {
+  result.clear();
+  if (text.empty())
+    return true;
+  char buffer[kContextUnits * 3];
+  const int length = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS,
+      text.data(), static_cast<int>(text.size()), buffer, sizeof(buffer),
+      nullptr, nullptr);
+  if (!length)
+    return false;
+  static const WCHAR digits[] = L"0123456789abcdef";
+  for (int i = 0; i < length; ++i) {
+    const auto byte = static_cast<unsigned char>(buffer[i]);
+    result.push_back(digits[byte >> 4]);
+    result.push_back(digits[byte & 15]);
+  }
+  return true;
+}
+
+}  // namespace smart_im
