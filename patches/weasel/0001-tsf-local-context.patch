-  bool allowed = count == 0 || scopes != nullptr;
-  for (UINT i = 0; allowed && i < count; ++i) {
-    switch (scopes[i]) {
-      case IS_PASSWORD:
-      case IS_PRIVATE:
-      case IS_NUMERIC_PASSWORD:
-      case IS_NUMERIC_PIN:
-      case IS_ALPHANUMERIC_PIN:
-      case IS_ALPHANUMERIC_PIN_SET:
-        allowed = false;
-        break;
-      default:
-        break;
-    }
-  }
-  CoTaskMemFree(scopes);
-  return allowed;
-}
-
 class CReadLocalContextSession : public CEditSession {
  public:
   CReadLocalContextSession(WeaselTSF* service, ITfContext* context)
@@ -99,7 +59,7 @@ bool WeaselTSF::_ReadLocalContext(ITfContext* context,
     return false;
   CComPtr<ITfRange> selectionRange;
   selectionRange.Attach(selection.range);
-  if (!AllowsContext(context, ec, selectionRange))
+  if (!smart_im::AllowsContext(context, ec, selectionRange))
     return false;
 
   CComPtr<ITfRange> replacement = selectionRange;
diff --git a/WeaselTSF/LocalContext.h b/WeaselTSF/LocalContext.h
index 6701900..b57eb68 100644
--- a/WeaselTSF/LocalContext.h
+++ b/WeaselTSF/LocalContext.h
@@ -3,6 +3,7 @@
 #include <string>
 #include <windows.h>
 #include <msctf.h>
+#include <inputscope.h>
 #include <atlcomcli.h>
 
 namespace smart_im {
@@ -77,4 +78,50 @@ inline bool Utf8Hex(const std::wstring& text, std::wstring& result) {
   return true;
 }
 
+// Missing optional input scopes are not password markers. Secure mode and
+// disabled input are checked by the caller before accessing document text.
+inline bool AllowsContext(ITfContext* context, TfEditCookie ec, ITfRange* selection) {
+  CComPtr<ITfReadOnlyProperty> property;
+  const HRESULT propertyResult = context->GetAppProperty(GUID_PROP_INPUTSCOPE, &property);
+  // TSF documents S_FALSE for an unsupported property and E_NOTIMPL for an
+  // owner without application properties. Both mean there is no scope hint.
+  if (propertyResult == S_FALSE || propertyResult == E_NOTIMPL)
+    return true;
+  if (FAILED(propertyResult) || !property)
+    return false;
+  CComVariant value;
+  if (FAILED(property->GetValue(ec, selection, &value)))
+    return false;
+  if (value.vt == VT_EMPTY)
+    return true;
+  if (value.vt != VT_UNKNOWN || !value.punkVal)
+    return false;
+  CComPtr<ITfInputScope> scope;
+  if (FAILED(value.punkVal->QueryInterface(IID_PPV_ARGS(&scope))))
+    return false;
+  InputScope* scopes = nullptr;
+  UINT count = 0;
+  if (FAILED(scope->GetInputScopes(&scopes, &count))) {
+    CoTaskMemFree(scopes);
+    return false;
+  }
+  bool allowed = count == 0 || scopes != nullptr;
+  for (UINT i = 0; allowed && i < count; ++i) {
+    switch (scopes[i]) {
+      case IS_PASSWORD:
+      case IS_PRIVATE:
+      case IS_NUMERIC_PASSWORD:
+      case IS_NUMERIC_PIN:
+      case IS_ALPHANUMERIC_PIN:
+      case IS_ALPHANUMERIC_PIN_SET:
+        allowed = false;
+        break;
+      default:
+        break;
+    }
+  }
+  CoTaskMemFree(scopes);
+  return allowed;
+}
+
 }  // namespace smart_im
diff --git a/WeaselTSF/tests/LocalContextTest.cpp b/WeaselTSF/tests/LocalContextTest.cpp
index 183346c..cdef513 100644
--- a/WeaselTSF/tests/LocalContextTest.cpp
+++ b/WeaselTSF/tests/LocalContextTest.cpp
@@ -1,6 +1,9 @@
 // Standalone Windows SDK/ATL test: cl /std:c++17 /EHsc /utf-8 /DUNICODE
 // /D_UNICODE LocalContextTest.cpp /link ole32.lib oleaut32.lib uuid.lib
 #define NOMINMAX
+#include <windows.h>
+#include <ole2.h>
+#include <initguid.h>
 #include "../LocalContext.h"
 #include <algorithm>
 #include <cassert>
@@ -129,7 +132,131 @@ static void ExpectAround(ITfRange* replacement,
   assert(actualBefore == before && actualAfter == after);
 }
 
+// These stack-owned COM fixtures exercise the production input-scope reader,
+// including hosts which do not implement the optional application property.
+template <class Interface>
+class ComFixture : public Interface {
+ public:
+  STDMETHODIMP QueryInterface(REFIID iid, void** out) override {
+    *out = nullptr;
+    if (iid != IID_IUnknown && iid != __uuidof(Interface)) return E_NOINTERFACE;
+    *out = static_cast<Interface*>(this);
+    AddRef();
+    return S_OK;
+  }
+  STDMETHODIMP_(ULONG) AddRef() override { return ++references; }
+  STDMETHODIMP_(ULONG) Release() override { return --references; }
+  ULONG references = 1;
+};
+
+#define UNUSED_METHOD(name, args) STDMETHODIMP name args override { return E_NOTIMPL; }
+
+class ScopeFixture : public ComFixture<ITfInputScope> {
+ public:
+  InputScope scope = IS_DEFAULT;
+  HRESULT result = S_OK;
+  STDMETHODIMP GetInputScopes(InputScope** scopes, UINT* count) override {
+    *scopes = nullptr;
+    *count = 0;
+    if (FAILED(result)) return result;
+    *scopes = static_cast<InputScope*>(CoTaskMemAlloc(sizeof(InputScope)));
+    if (!*scopes) return E_OUTOFMEMORY;
+    **scopes = scope;
+    *count = 1;
+    return result;
+  }
+  UNUSED_METHOD(GetPhrase, (BSTR**, UINT*))
+  UNUSED_METHOD(GetRegularExpression, (BSTR*))
+  UNUSED_METHOD(GetSRGS, (BSTR*))
+  UNUSED_METHOD(GetXML, (BSTR*))
+};
+
+class PropertyFixture : public ComFixture<ITfReadOnlyProperty> {
+ public:
+  ScopeFixture scope;
+  VARTYPE type = VT_EMPTY;
+  HRESULT result = S_OK;
+  STDMETHODIMP GetValue(TfEditCookie ec, ITfRange*, VARIANT* value) override {
+    assert(ec == 42);
+    VariantInit(value);
+    if (FAILED(result)) return result;
+    value->vt = type;
+    if (type == VT_UNKNOWN) {
+      value->punkVal = &scope;
+      scope.AddRef();
+    }
+    return result;
+  }
+  UNUSED_METHOD(GetType, (GUID*))
+  UNUSED_METHOD(EnumRanges, (TfEditCookie, IEnumTfRanges**, ITfRange*))
+  UNUSED_METHOD(GetContext, (ITfContext**))
+};
+
+class ContextFixture : public ComFixture<ITfContext> {
+ public:
+  HRESULT result = S_FALSE;
+  PropertyFixture property;
+  STDMETHODIMP GetAppProperty(REFGUID guid, ITfReadOnlyProperty** out) override {
+    assert(guid == GUID_PROP_INPUTSCOPE);
+    *out = nullptr;
+    if (result == S_OK) { *out = &property; property.AddRef(); }
+    return result;
+  }
+  UNUSED_METHOD(RequestEditSession, (TfClientId, ITfEditSession*, DWORD, HRESULT*))
+  UNUSED_METHOD(InWriteSession, (TfClientId, BOOL*))
+  UNUSED_METHOD(GetSelection, (TfEditCookie, ULONG, ULONG, TF_SELECTION*, ULONG*))
+  UNUSED_METHOD(SetSelection, (TfEditCookie, ULONG, const TF_SELECTION*))
+  UNUSED_METHOD(GetStart, (TfEditCookie, ITfRange**))
+  UNUSED_METHOD(GetEnd, (TfEditCookie, ITfRange**))
+  UNUSED_METHOD(GetActiveView, (ITfContextView**))
+  UNUSED_METHOD(EnumViews, (IEnumTfContextViews**))
+  UNUSED_METHOD(GetStatus, (TF_STATUS*))
+  UNUSED_METHOD(GetProperty, (REFGUID, ITfProperty**))
+  UNUSED_METHOD(TrackProperties, (const GUID**, ULONG, const GUID**, ULONG, ITfReadOnlyProperty**))
+  UNUSED_METHOD(EnumProperties, (IEnumTfProperties**))
+  UNUSED_METHOD(GetDocumentMgr, (ITfDocumentMgr**))
+  UNUSED_METHOD(CreateRangeBackup, (TfEditCookie, ITfRange*, ITfRangeBackup**))
+};
+
+#undef UNUSED_METHOD
+
+static void TestInputScopes() {
+  ContextFixture context;
+  // No property object is returned for these documented optional-property cases.
+  assert(smart_im::AllowsContext(&context, 42, nullptr));
+  context.result = E_NOTIMPL;
+  assert(smart_im::AllowsContext(&context, 42, nullptr));
+  for (HRESULT failure : {E_FAIL, E_INVALIDARG, TF_E_DISCONNECTED, E_OUTOFMEMORY}) {
+    context.result = failure;
+    assert(!smart_im::AllowsContext(&context, 42, nullptr));
+  }
+  context.result = S_OK;
+  assert(smart_im::AllowsContext(&context, 42, nullptr)); // VT_EMPTY
+  context.property.result = S_FALSE;
+  assert(smart_im::AllowsContext(&context, 42, nullptr)); // uncovered property
+  context.property.result = TF_E_NOLOCK;
+  assert(!smart_im::AllowsContext(&context, 42, nullptr));
+  context.property.result = S_OK;
+  context.property.type = VT_I4;
+  assert(!smart_im::AllowsContext(&context, 42, nullptr));
+  context.property.type = VT_UNKNOWN;
+  assert(smart_im::AllowsContext(&context, 42, nullptr)); // IS_DEFAULT
+  context.property.scope.scope = IS_TEXT;
+  assert(smart_im::AllowsContext(&context, 42, nullptr));
+  for (InputScope privateScope : {IS_PASSWORD, IS_PRIVATE, IS_NUMERIC_PASSWORD,
+                                 IS_NUMERIC_PIN, IS_ALPHANUMERIC_PIN,
+                                 IS_ALPHANUMERIC_PIN_SET}) {
+    context.property.scope.scope = privateScope;
+    assert(!smart_im::AllowsContext(&context, 42, nullptr));
+  }
+  context.property.scope.scope = IS_TEXT;
+  context.property.scope.result = E_FAIL;
+  assert(!smart_im::AllowsContext(&context, 42, nullptr));
+  assert(context.property.references == 1 && context.property.scope.references == 1);
+}
+
 int main() {
+  TestInputScopes();
   // Existing text is read at the insertion point without any commit history.
   auto doc = DocumentWith(L"原有语境。这里继续。");
   ExpectAround(At(doc, 5, 5), L"原有语境。", L"这里继续。");

