     if (!*scopes) return E_OUTOFMEMORY;
     **scopes = scope;
@@ -175,13 +181,13 @@ class PropertyFixture : public ComFixture<ITfReadOnlyProperty> {
  public:
   ScopeFixture scope;
   VARTYPE type = VT_EMPTY;
