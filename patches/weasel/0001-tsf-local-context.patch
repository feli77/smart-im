diff --git a/WeaselTSF/tests/LocalContextTest.cpp b/WeaselTSF/tests/LocalContextTest.cpp
new file mode 100644
index 0000000..183346c
--- /dev/null
+++ b/WeaselTSF/tests/LocalContextTest.cpp
@@ -0,0 +1,183 @@
+// Standalone Windows SDK/ATL test: cl /std:c++17 /EHsc /utf-8 /DUNICODE
+// /D_UNICODE LocalContextTest.cpp /link ole32.lib oleaut32.lib uuid.lib
+#define NOMINMAX
+#include "../LocalContext.h"
+#include <algorithm>
+#include <cassert>
+#include <iostream>
+#include <memory>
+
+struct Document {
+  std::wstring text;
+  LONG regionStart = 0;
+  LONG regionEnd = 0;
+  bool failRead = false;
+  bool shortRead = false;
+};
+
+// A real COM ITfRange implementation with document/region bounds. Unexpected
+// write and whole-document APIs fail, so these tests exercise the TSF reader.
+class Range final : public ITfRange {
+ public:
+  Range(std::shared_ptr<Document> doc, LONG start, LONG end)
+      : doc_(std::move(doc)), start_(start), end_(end) {}
+  STDMETHODIMP QueryInterface(REFIID iid, void** out) override {
+    *out = nullptr;
+    if (iid != IID_IUnknown && iid != IID_ITfRange)
+      return E_NOINTERFACE;
+    *out = static_cast<ITfRange*>(this);
+    AddRef();
+    return S_OK;
+  }
+  STDMETHODIMP_(ULONG) AddRef() override { return ++refs_; }
+  STDMETHODIMP_(ULONG) Release() override {
+    const auto remaining = --refs_;
+    if (!remaining) delete this;
+    return remaining;
+  }
+  STDMETHODIMP GetText(TfEditCookie ec, DWORD flags, WCHAR* text,
+                       ULONG capacity, ULONG* count) override {
+    assert(ec == 42 && flags == 0 && capacity == smart_im::kContextUnits);
+    if (doc_->failRead) return TF_E_NOLOCK;
+    *count = (std::min)(capacity, static_cast<ULONG>(end_ - start_));
+    if (doc_->shortRead && *count) --*count;
+    std::copy_n(doc_->text.data() + start_, *count, text);
+    return S_OK;
+  }
+  STDMETHODIMP ShiftStart(TfEditCookie ec, LONG delta, LONG* moved,
+                          const TF_HALTCOND*) override {
+    assert(ec == 42 && delta == -128);
+    const auto original = start_;
+    start_ = (std::max)(doc_->regionStart, start_ + delta);
+    *moved = start_ - original;
+    return S_OK;
+  }
+  STDMETHODIMP ShiftEnd(TfEditCookie ec, LONG delta, LONG* moved,
+                        const TF_HALTCOND*) override {
+    assert(ec == 42 && delta == 128);
+    const auto original = end_;
+    end_ = (std::min)(doc_->regionEnd, end_ + delta);
+    *moved = end_ - original;
+    return S_OK;
+  }
+  STDMETHODIMP Collapse(TfEditCookie ec, TfAnchor anchor) override {
+    assert(ec == 42);
+    if (anchor == TF_ANCHOR_START) end_ = start_; else start_ = end_;
+    return S_OK;
+  }
+  STDMETHODIMP CompareStart(TfEditCookie, ITfRange* other, TfAnchor anchor,
+                            LONG* result) override {
+    auto range = static_cast<Range*>(other);
+    if (doc_ != range->doc_) return E_INVALIDARG;
+    *result = start_ - (anchor == TF_ANCHOR_START ? range->start_ : range->end_);
+    return S_OK;
+  }
+  STDMETHODIMP CompareEnd(TfEditCookie, ITfRange* other, TfAnchor anchor,
+                          LONG* result) override {
+    auto range = static_cast<Range*>(other);
+    if (doc_ != range->doc_) return E_INVALIDARG;
+    *result = end_ - (anchor == TF_ANCHOR_START ? range->start_ : range->end_);
+    return S_OK;
+  }
+  STDMETHODIMP Clone(ITfRange** out) override {
+    *out = new Range(doc_, start_, end_);
+    return S_OK;
+  }
+#define NOT_USED(name, signature) STDMETHODIMP name signature override { return E_NOTIMPL; }
+  NOT_USED(SetText, (TfEditCookie, DWORD, const WCHAR*, LONG))
+  NOT_USED(GetFormattedText, (TfEditCookie, IDataObject**))
+  NOT_USED(GetEmbedded, (TfEditCookie, REFGUID, REFIID, IUnknown**))
+  NOT_USED(InsertEmbedded, (TfEditCookie, DWORD, IDataObject*))
+  NOT_USED(ShiftStartToRange, (TfEditCookie, ITfRange*, TfAnchor))
+  NOT_USED(ShiftEndToRange, (TfEditCookie, ITfRange*, TfAnchor))
+  NOT_USED(ShiftStartRegion, (TfEditCookie, TfShiftDir, BOOL*))
+  NOT_USED(ShiftEndRegion, (TfEditCookie, TfShiftDir, BOOL*))
+  NOT_USED(IsEmpty, (TfEditCookie, BOOL*))
+  NOT_USED(IsEqualStart, (TfEditCookie, ITfRange*, TfAnchor, BOOL*))
+  NOT_USED(IsEqualEnd, (TfEditCookie, ITfRange*, TfAnchor, BOOL*))
+  NOT_USED(AdjustForInsert, (TfEditCookie, ULONG, BOOL*))
+  NOT_USED(GetGravity, (TfGravity*, TfGravity*))
+  NOT_USED(SetGravity, (TfEditCookie, TfGravity, TfGravity))
+  NOT_USED(GetContext, (ITfContext**))
+#undef NOT_USED
+
+ private:
+  ULONG refs_ = 1;
+  std::shared_ptr<Document> doc_;
+  LONG start_, end_;
+};
+
+static auto DocumentWith(std::wstring text) {
+  auto document = std::make_shared<Document>();
+  document->text = std::move(text);
+  document->regionEnd = static_cast<LONG>(document->text.size());
+  return document;
+}
+
+static CComPtr<ITfRange> At(std::shared_ptr<Document> document, LONG start, LONG end) {
+  CComPtr<ITfRange> range;
+  range.Attach(new Range(std::move(document), start, end));
+  return range;
+}
+
+static void ExpectAround(ITfRange* replacement,
+                         const std::wstring& before,
+                         const std::wstring& after) {
+  std::wstring actualBefore, actualAfter;
+  assert(smart_im::ReadSide(42, replacement, true, actualBefore));
+  assert(smart_im::ReadSide(42, replacement, false, actualAfter));
+  assert(actualBefore == before && actualAfter == after);
+}
+
+int main() {
+  // Existing text is read at the insertion point without any commit history.
+  auto doc = DocumentWith(L"原有语境。这里继续。");
+  ExpectAround(At(doc, 5, 5), L"原有语境。", L"这里继续。");
+  ExpectAround(At(doc, 0, 0), L"", doc->text);
+  ExpectAround(At(doc, 10, 10), doc->text, L"");
+
+  // Inline selected Chinese + active pinyin all belong to composition and
+  // must be excluded. Lua will add the selected prefix exactly once.
+  doc = DocumentWith(L"原文已经选中pin yin后文");
+  auto composition = At(doc, 2, 13);
+  auto caret = At(doc, 9, 9);
+  assert(smart_im::Covers(42, composition, caret));
+  ExpectAround(composition, L"原文", L"后文");
+  assert(!smart_im::Covers(42, composition, At(doc, 0, 0)));
+  // 0.17.4's non-inline placeholder is not document context either.
+  doc = DocumentWith(L"原文 后文");
+  ExpectAround(At(doc, 2, 3), L"原文", L"后文");
+  // A nonempty selected body range is replaced, so neither side includes it.
+  doc = DocumentWith(L"之前替换这段之后");
+  ExpectAround(At(doc, 2, 6), L"之前", L"之后");
+
+  // Repeated text cannot hide a caret move or a different document.
+  doc = DocumentWith(L"重复重复");
+  assert(!smart_im::SameRange(42, At(doc, 0, 0), At(doc, 2, 2)));
+  assert(!smart_im::SameRange(42, At(doc, 2, 2),
+                              At(DocumentWith(doc->text), 2, 2)));
+
+  doc = DocumentWith(std::wstring(500, L'前') + L"X" + std::wstring(500, L'后'));
+  ExpectAround(At(doc, 500, 501), std::wstring(128, L'前'), std::wstring(128, L'后'));
+  doc->regionStart = 498;
+  doc->regionEnd = 503;
+  ExpectAround(At(doc, 500, 501), L"前前", L"后后");
+
+  // UTF-16 edge clipping never emits half an emoji as invalid UTF-8.
+  doc = DocumentWith(L"\U0001f642" + std::wstring(127, L'前') + L"X" +
+                     std::wstring(127, L'后') + L"\U0001f642");
+  ExpectAround(At(doc, 129, 130), std::wstring(127, L'前'), std::wstring(127, L'后'));
+  std::wstring encoded;
+  assert(smart_im::Utf8Hex(L"\U0001f642中\t\n", encoded));
+  assert(encoded == L"f09f9982e4b8ad090a");
+  assert(!smart_im::Utf8Hex(std::wstring(1, 0xd800), encoded));
+
+  doc = DocumentWith(L"之前之后");
+  auto range = At(doc, 2, 2);
+  doc->failRead = true;
+  assert(!smart_im::ReadSide(42, range, true, encoded));
+  doc->failRead = false;
+  doc->shortRead = true;
+  assert(!smart_im::ReadSide(42, range, true, encoded));
+  std::cout << "TSF COM range tests passed\n";
+}
