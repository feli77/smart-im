+bool RimeWithWeaselHandler::UpdateLocalContext(const std::wstring& packet,
+                                              WeaselSessionId ipc_id) {
+  auto found = m_session_status_map.find(ipc_id);
+  if (m_disabled || found == m_session_status_map.end())
+    return false;
+  const auto session_id = found->second.session_id;
+  if (!_IsSessionTSF(session_id))
+    return false;
+  const bool valid = smart_im::ValidPacket(packet);
+  // ASCII framing is intentional: document text is UTF-8 hex, never logged.
+  const std::string value = valid ? std::string(packet.begin(), packet.end()) : "";
+  char previous[smart_im::kMaxPacket + 1] = {};
+  if (rime_api->get_property(session_id, "smart_im_context", previous, sizeof(previous)) &&
+      value == previous)
+    return valid;
+  rime_api->set_property(session_id, "smart_im_context", value.c_str());
+  // Lua's property notifier has now removed stale requests/results and rebuilt
+  // its original candidates. Refresh the server-owned candidate window too.
+  if (m_active_session == ipc_id)
+    _UpdateUI(ipc_id);
+  return valid;
+}
