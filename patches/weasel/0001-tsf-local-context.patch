   if (!before && !text.empty() && text.back() >= 0xd800 && text.back() <= 0xdbff)
     text.pop_back();
-  return text.find(L'\0') == std::wstring::npos;
+  if (text.find(L'\0') != std::wstring::npos) {
+    TraceContext(before ? "read.before.embedded-null" : "read.after.embedded-null",
+                 E_UNEXPECTED, count);
+    return false;
