diff --git a/WeaselTSF/LocalContext.h b/WeaselTSF/LocalContext.h
index b57eb68..9861b79 100644
--- a/WeaselTSF/LocalContext.h
+++ b/WeaselTSF/LocalContext.h
@@ -80,33 +80,57 @@ inline bool Utf8Hex(const std::wstring& text, std::wstring& result) {
 
 // Missing optional input scopes are not password markers. Secure mode and
 // disabled input are checked by the caller before accessing document text.
-inline bool AllowsContext(ITfContext* context, TfEditCookie ec, ITfRange* selection) {
+// The optional diagnostic distinguishes no scope hint (S_FALSE), a permitted
+// scope (S_OK), sensitive scope (E_ACCESSDENIED), and an actual API failure.
+inline bool AllowsContext(ITfContext* context,
+                          TfEditCookie ec,
+                          ITfRange* selection,
+                          HRESULT* reason = nullptr) {
+  const auto finish = [reason](HRESULT result) {
+    if (reason)
+      *reason = result;
+    return SUCCEEDED(result);
+  };
+  if (!context)
+    return finish(E_INVALIDARG);
   CComPtr<ITfReadOnlyProperty> property;
   const HRESULT propertyResult = context->GetAppProperty(GUID_PROP_INPUTSCOPE, &property);
   // TSF documents S_FALSE for an unsupported property and E_NOTIMPL for an
   // owner without application properties. Both mean there is no scope hint.
   if (propertyResult == S_FALSE || propertyResult == E_NOTIMPL)
-    return true;
-  if (FAILED(propertyResult) || !property)
-    return false;
+    return finish(S_FALSE);
+  if (FAILED(propertyResult))
+    return finish(propertyResult);
+  if (!property)
+    return finish(E_UNEXPECTED);
   CComVariant value;
-  if (FAILED(property->GetValue(ec, selection, &value)))
-    return false;
+  const HRESULT valueResult = property->GetValue(ec, selection, &value);
+  // Windows also returns E_FAIL/VT_EMPTY when an ITextStoreACP supplies no
+  // optional scope attribute. Keep this compatibility case narrow: lock,
+  // disconnection and other errors, or a nonempty failed value, still reject.
+  if (valueResult == E_FAIL && value.vt == VT_EMPTY)
+    return finish(S_FALSE);
+  if (FAILED(valueResult))
+    return finish(valueResult);
   if (value.vt == VT_EMPTY)
-    return true;
+    return finish(S_FALSE);
   if (value.vt != VT_UNKNOWN || !value.punkVal)
-    return false;
+    return finish(E_UNEXPECTED);
   CComPtr<ITfInputScope> scope;
-  if (FAILED(value.punkVal->QueryInterface(IID_PPV_ARGS(&scope))))
-    return false;
+  const HRESULT scopeResult = value.punkVal->QueryInterface(IID_PPV_ARGS(&scope));
+  if (FAILED(scopeResult))
+    return finish(scopeResult);
+  if (!scope)
+    return finish(E_UNEXPECTED);
   InputScope* scopes = nullptr;
   UINT count = 0;
-  if (FAILED(scope->GetInputScopes(&scopes, &count))) {
+  const HRESULT inputResult = scope->GetInputScopes(&scopes, &count);
+  if (FAILED(inputResult)) {
     CoTaskMemFree(scopes);
-    return false;
+    return finish(inputResult);
   }
-  bool allowed = count == 0 || scopes != nullptr;
-  for (UINT i = 0; allowed && i < count; ++i) {
+  HRESULT result = count == 0 ? S_FALSE : (scopes ? S_OK : E_UNEXPECTED);
+  for (UINT i = 0; SUCCEEDED(result) && i < count; ++i) {
     switch (scopes[i]) {
       case IS_PASSWORD:
       case IS_PRIVATE:
@@ -114,14 +138,14 @@ inline bool AllowsContext(ITfContext* context, TfEditCookie ec, ITfRange* select
       case IS_NUMERIC_PIN:
       case IS_ALPHANUMERIC_PIN:
       case IS_ALPHANUMERIC_PIN_SET:
-        allowed = false;
+        result = E_ACCESSDENIED;
         break;
       default:
         break;
     }
   }
   CoTaskMemFree(scopes);
-  return allowed;
+  return finish(result);
 }
 
 }  // namespace smart_im
