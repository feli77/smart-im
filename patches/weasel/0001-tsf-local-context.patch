+bool ClientImpl::UpdateLocalContext(const std::wstring& packet) {
+  if (!_Active() || !smart_im::ValidPacket(packet))
+    return false;
+  try {
+    context_channel << packet.c_str() << L'\0';
+    PipeMessage request{WEASEL_IPC_UPDATE_LOCAL_CONTEXT,
+                        static_cast<DWORD>(packet.size()), session_id};
+    return context_channel.Transact(request) != 0;
+  } catch (DWORD) {
+    context_channel.ClearBufferStream();
+    return false;
+  }
+}
